<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Draws the floating bubble over other apps. User grants this manually
         via Settings.ACTION_MANAGE_OVERLAY_PERMISSION — see SettingsScreen. -->
    <!-- Only used to download the GGUF/Whisper/Piper model files the user
         explicitly opts into fetching (see ModelManager.kt). No telemetry,
         analytics, or cloud inference calls anywhere in the app. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Push-to-talk mic capture for the offline Whisper speech-to-text
         pipeline (voice/AudioRecorder.kt, voice/VoiceManager.kt). Requested
         at runtime from ChatScreen/OverlayService before first use — audio
         never leaves the device, there's no cloud STT call anywhere. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Required so OverlayService can run as a foreground service with a
         persistent notification while the bubble is on screen. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- MediaProjection screen capture (screenshots -> OCR), distinct from
         the Accessibility Service's UI-tree reading. Android 14+ requires
         this specific foreground-service-type permission for any app that
         uses MediaProjection. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.LamdaAI">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LamdaAI">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Gives LamdaAI read access to the on-screen UI hierarchy and the
          ability to tap/type/scroll on the user's behalf, gated per
          LamdaAccessibilityService's ActionGate (sensitive actions like
          send/pay/delete require explicit confirmation, not just this
          system permission). Inert until the user enables it in
          Settings > Accessibility > LamdaAI.
        -->
        <service
            android:name=".accessibility.LamdaAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Draws the floating bubble. Only runs once the user starts it
             from Settings after granting the overlay permission above. -->
        <service
            android:name=".overlay.OverlayService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Floating assistant bubble the user explicitly enabled" />
        </service>

        <!--
          Holds the MediaProjection session for on-demand screenshots that
          feed OCR (see screen/OcrEngine.kt, screen/ScreenCaptureService.kt).
          Only runs while the user has "Screen understanding" switched on in
          Settings; Android shows its own screen-capture indicator the whole
          time this is active.
        -->
        <service
            android:name=".screen.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

    </application>
</manifest>
