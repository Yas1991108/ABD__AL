<?xml version="1.0" encoding="utf-8"?>
<!-- Matches the chip artwork's own background so the adaptive-icon mask
     (circle/squircle/rounded-square, varies by launcher) never shows a
     visible seam around the chip. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#FFFFFF" />
</shape>
